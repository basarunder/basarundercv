              {data.affiliations.map((item, idx) => (
                <div key={idx} className="flex gap-2">
                  <textarea rows="2" value={item} onChange={(e) => handleArrayChange('affiliations', idx, e.target.value)} className="flex-1 border border-gray-300 rounded p-2 text-sm outline-none focus:border-teal-500 resize-none"></textarea>
                  <button onClick={() => removeFromArray('affiliations', idx)} className="text-red-400 hover:text-red-600 p-2"><Trash2 size={16}/></button>
                </div>
              ))}
              <button onClick={() => addToArray('affiliations')} className="text-teal-600 hover:text-teal-800 text-sm font-medium flex items-center gap-1 mt-2">
                <Plus size={16}/> Yeni Ekle
              </button>
            </div>
          </section>

          {/* Deneyimler */}
          <section>
            <div className="flex justify-between items-center mb-4">
              <h3 className="text-xs font-bold text-gray-400 uppercase tracking-wider">DENEYİM (EXPERIENCE)</h3>
            </div>
            <div>
              <label className="block text-xs text-gray-600 mb-2">Orta Dikey Başlık</label>
              <input type="text" value={data.midTitle} onChange={(e) => handleChange('midTitle', e.target.value)} className="w-full border border-gray-300 rounded p-2 text-sm outline-none focus:border-teal-500 mb-4" />
            </div>
            
            <div className="space-y-6">
              {data.experiences.map((exp, expIdx) => (
                <div key={expIdx} className="bg-gray-50 border border-gray-200 p-4 rounded-lg relative">
                  <button onClick={() => removeExperienceBlock(expIdx)} className="absolute top-3 right-3 text-red-400 hover:text-red-600"><Trash2 size={16}/></button>
                  
                  <div className="space-y-3 pr-6">
                    <div>
                      <label className="block text-[10px] text-gray-500 uppercase mb-1">Tarih</label>
                      <input type="text" value={exp.date} onChange={(e) => handleExpChange(expIdx, 'date', e.target.value)} placeholder="Örn: 2018 - Present" className="w-full border border-gray-300 rounded p-2 text-sm outline-none focus:border-teal-500" />
                    </div>
                    <div>
                      <label className="block text-[10px] text-gray-500 uppercase mb-1">Kurum / Pozisyon</label>
                      <input type="text" value={exp.company} onChange={(e) => handleExpChange(expIdx, 'company', e.target.value)} placeholder="Örn: BAHÇEŞEHİR UNIVERSITY" className="w-full border border-gray-300 rounded p-2 text-sm outline-none focus:border-teal-500" />
                    </div>
                    
                    <div>
                      <label className="block text-[10px] text-gray-500 uppercase mb-2">Maddeler (Kalın yapmak için **kelime** kullanın)</label>
                      <div className="space-y-2">
                        {exp.items.map((item, itemIdx) => (
                          <div key={itemIdx} className="flex gap-2">
                             <textarea rows="2" value={item} onChange={(e) => handleExpItemChange(expIdx, itemIdx, e.target.value)} className="flex-1 border border-gray-300 rounded p-2 text-sm outline-none focus:border-teal-500 resize-none"></textarea>
                             <button onClick={() => removeExpItem(expIdx, itemIdx)} className="text-red-400 hover:text-red-600 p-1"><Trash2 size={14}/></button>
                          </div>
                        ))}
                      </div>
                      <button onClick={() => addExpItem(expIdx)} className="text-teal-600 hover:text-teal-800 text-xs font-medium flex items-center gap-1 mt-2">
                        <Plus size={14}/> Madde Ekle
                      </button>
                    </div>
                  </div>
                </div>
              ))}
              
              <button onClick={addExperienceBlock} className="w-full bg-gray-200 hover:bg-gray-300 text-gray-700 font-medium py-2 rounded-lg flex justify-center items-center gap-2 text-sm transition-colors">
                <Plus size={16}/> Yeni Deneyim Bloğu Ekle
              </button>
            </div>
          </section>

          {/* İlgi Alanları */}
          <section>
            <h3 className="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">İLİG ALANLARI (INTERESTS)</h3>
            <div className="space-y-2">
              {data.interests.map((item, idx) => (
                <div key={idx} className="flex gap-2">
                  <input type="text" value={item} onChange={(e) => handleArrayChange('interests', idx, e.target.value)} className="flex-1 border border-gray-300 rounded p-2 text-sm outline-none focus:border-teal-500" />
                  <button onClick={() => removeFromArray('interests', idx)} className="text-red-400 hover:text-red-600 p-2"><Trash2 size={16}/></button>
                </div>
              ))}
              <button onClick={() => addToArray('interests')} className="text-teal-600 hover:text-teal-800 text-sm font-medium flex items-center gap-1 mt-2">
                <Plus size={16}/> Yeni Ekle
              </button>
            </div>
          </section>

          {/* İletişim */}
          <section className="pb-10">
            <h3 className="text-xs font-bold text-gray-400 uppercase tracking-wider mb-4">İLETİŞİM (CONTACT)</h3>
            <div className="space-y-3">
              <div>
                <label className="block text-xs text-gray-600 mb-1">Telefon</label>
                <input type="text" value={data.contact.phone} onChange={(e) => handleNestedChange('contact', 'phone', e.target.value)} className="w-full border border-gray-300 rounded p-2 text-sm outline-none focus:border-teal-500" />
              </div>
              <div>
                <label className="block text-xs text-gray-600 mb-1">E-Posta</label>
                <input type="text" value={data.contact.email} onChange={(e) => handleNestedChange('contact', 'email', e.target.value)} className="w-full border border-gray-300 rounded p-2 text-sm outline-none focus:border-teal-500" />
              </div>
              <div>
                <label className="block text-xs text-gray-600 mb-1">Web Sitesi</label>
                <input type="text" value={data.contact.website} onChange={(e) => handleNestedChange('contact', 'website', e.target.value)} className="w-full border border-gray-300 rounded p-2 text-sm outline-none focus:border-teal-500" />
              </div>
            </div>
          </section>

        </div>
      </div>

      {/* SAĞ PANEL: CV ÖNİZLEME (PREVIEW) */}
      <div className="preview-panel flex-1 h-full overflow-y-auto bg-[#cddad7] py-10 px-4 flex justify-center items-start">
        
        {/* SABİT A4 KAĞIDI ALANI */}
        <div 
          id="pdf-content"
          className="cv-page-wrapper shadow-2xl transition-all duration-300"
          style={{
            '--bg-color': THEMES[activeTheme].bg,
            '--border-color': THEMES[activeTheme].border,
            '--font-main': FONTS[activeFont].family,
            '--border-style': BORDERS[activeBorderStyle].value,
            '--border-width': BORDERS[activeBorderStyle].width,
            '--text-size': TEXT_SIZES[activeSize].text,
            '--h2-size': TEXT_SIZES[activeSize].h2,
            '--h1-size': TEXT_SIZES[activeSize].h1,
            '--title-size': TEXT_SIZES[activeSize].title,
            '--pad-cell': SPACING[activeSpacing].cell,
            '--pad-header': SPACING[activeSpacing].header,
            '--pad-footer': SPACING[activeSpacing].footer,
            '--pad-wrapper': SPACING[activeSpacing].wrapper,
          }}
        >
          {/* SİYAH İÇ ÇERÇEVE */}
          <div className="cv-document">
              
              {/* BAŞLIK */}
              <div className="cv-row cv-header">
                  <h1>{data.name}</h1>
              </div>

              {/* TEACHER KISMI */}
              <div className="cv-row" style={{ minHeight: '140px' }}>
                  <div className="cv-vertical-box cv-teacher-box">
                      <span className="cv-vertical-title">{data.leftTitle}</span>
                  </div>
                  <div className="cv-teacher-content">
                      {data.summary}
                  </div>
              </div>

              {/* ANA İÇERİK (3 KOLON) */}
              <div className="cv-row cv-main-row">
                  
                  {/* Sol Kolon */}
                  <div className="cv-col-left">
                      <div className="cv-cell">
                          <h2>EDUCATION</h2>
                          <ul>
                              {data.education.map((item, i) => (
                                  <li key={`edu-${i}`}>{renderFormattedText(item)}</li>
                              ))}
                          </ul>
                      </div>
                      
                      <div className="cv-cell">
                          <h2>SKILLS</h2>
                          <ul>
                              {data.skills.map((item, i) => (
                                  <li key={`skill-${i}`}>{renderFormattedText(item)}</li>
                              ))}
                          </ul>
                      </div>
                      
                      <div className="cv-cell">
                          <h2>PROFESSIONAL AFFILIATIONS & RECOGNITION</h2>
                          <ul>
                              {data.affiliations.map((item, i) => (
                                  <li key={`aff-${i}`}>{renderFormattedText(item)}</li>
                              ))}
                          </ul>
                      </div>
                  </div>

                  {/* Orta Kolon (Dikey Çizgili Başlık) */}
                  <div className="cv-vertical-box cv-col-mid">
                      <span className="cv-vertical-title">{data.midTitle}</span>
                  </div>

                  {/* Sağ Kolon */}
                  <div className="cv-col-right">
                      
                      {data.experiences.map((exp, idx) => (
                          <div key={`exp-${idx}`} className="cv-cell">
                              <div className="cv-experience-header">
                                  {exp.date}
                                  <strong>{exp.company}</strong>
                              </div>
                              <ul>
                                  {exp.items.map((item, i) => (
                                      <li key={`expitem-${i}`}>{renderFormattedText(item)}</li>
                                  ))}
                              </ul>
                          </div>
                      ))}
                      
                      <div className="cv-cell">
                          <h2>INTERESTS</h2>
                          <ul>
                              {data.interests.map((item, i) => (
                                  <li key={`int-${i}`}>{renderFormattedText(item)}</li>
                              ))}
                          </ul>
                      </div>
                  </div>
                  
              </div>

              {/* İLETİŞİM KISMI */}
              <div className="cv-row cv-footer">
                  <h2>CONTACT</h2>
                  <div className="cv-contact-grid">
                      <span className="cv-contact-item">
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                          {data.contact.phone}
                      </span>
                      <span className="cv-contact-item">
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                          {data.contact.email}
                      </span>
                      <span className="cv-contact-item">
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1 4-10z"></path></svg>
                          {data.contact.website}
                      </span>
                  </div>
              </div>

          </div>
        </div>
      </div>
    </div>
  );
}
