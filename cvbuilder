export default function App() {
  const [data, setData] = useState(initialData);
  const [activeTheme, setActiveTheme] = useState('mint');
  const [activeFont, setActiveFont] = useState('space-mono');
  const [activeBorderStyle, setActiveBorderStyle] = useState('solid');
  const [activeSize, setActiveSize] = useState('md');
  const [activeSpacing, setActiveSpacing] = useState('normal');
  const [isGeneratingPdf, setIsGeneratingPdf] = useState(false);

  // --- VERİ GÜNCELLEME FONKSİYONLARI ---
  const handleChange = (field, value) => setData({ ...data, [field]: value });
  const handleNestedChange = (parent, field, value) => setData({ ...data, [parent]: { ...data[parent], [field]: value } });
  
  const handleArrayChange = (field, index, value) => {
    const newArray = [...data[field]];
    newArray[index] = value;
    setData({ ...data, [field]: newArray });
  };
  const addToArray = (field, defaultValue = "") => setData({ ...data, [field]: [...data[field], defaultValue] });
  const removeFromArray = (field, index) => setData({ ...data, [field]: data[field].filter((_, i) => i !== index) });

  const handleExpChange = (expIndex, field, value) => {
    const newExps = [...data.experiences];
    newExps[expIndex][field] = value;
    setData({ ...data, experiences: newExps });
  };
  const handleExpItemChange = (expIndex, itemIndex, value) => {
    const newExps = [...data.experiences];
    newExps[expIndex].items[itemIndex] = value;
    setData({ ...data, experiences: newExps });
  };
  const addExpItem = (expIndex) => {
    const newExps = [...data.experiences];
    newExps[expIndex].items.push("");
    setData({ ...data, experiences: newExps });
  };
  const removeExpItem = (expIndex, itemIndex) => {
    const newExps = [...data.experiences];
    newExps[expIndex].items = newExps[expIndex].items.filter((_, i) => i !== itemIndex);
    setData({ ...data, experiences: newExps });
  };
  const addExperienceBlock = () => setData({ ...data, experiences: [...data.experiences, { date: "", company: "", items: [""] }] });
  const removeExperienceBlock = (expIndex) => setData({ ...data, experiences: data.experiences.filter((_, i) => i !== expIndex) });

  // --- PDF İNDİRME FONKSİYONU ---
  const handleDownloadPdf = async () => {
    setIsGeneratingPdf(true);
    
    try {
      await document.fonts.ready;

      if (!window.html2canvas) {
        const script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js';
        document.body.appendChild(script);
        await new Promise((resolve) => { script.onload = resolve; });
      }
      if (!window.jspdf) {
        const script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
        document.body.appendChild(script);
        await new Promise((resolve) => { script.onload = resolve; });
      }

      const currentScroll = window.scrollY;
      window.scrollTo(0, 0);

      const element = document.getElementById('pdf-content');

      const canvas = await window.html2canvas(element, {
        scale: 2, 
        useCORS: true,
        logging: false,
        width: 794,
        height: 1123,
        windowWidth: 794,
        windowHeight: 1123
      });

      const imgData = canvas.toDataURL('image/jpeg', 1.0);
      const { jsPDF } = window.jspdf;
      
      const pdf = new jsPDF({
        orientation: 'portrait',
        unit: 'mm',
        format: 'a4' 
      });

      pdf.addImage(imgData, 'JPEG', 0, 0, 210, 297);
      pdf.save(`${data.name.replace(/\s+/g, '_')}_CV.pdf`);

      window.scrollTo(0, currentScroll);

    } catch (error) {
      console.error("PDF oluşturulurken hata oluştu:", error);
    } finally {
      setIsGeneratingPdf(false);
    }
  };

  // --- ÖZEL METİN PARÇALAYICI ---
  const renderFormattedText = (text) => {
    if (!text) return null;
    const parts = text.split(/\*\*(.*?)\*\*/g);
    return parts.map((part, index) => 
      index % 2 === 1 ? <strong key={index}>{part}</strong> : part
    );
  };

